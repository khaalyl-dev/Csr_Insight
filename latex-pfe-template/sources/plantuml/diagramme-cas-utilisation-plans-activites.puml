@startuml
!theme plain
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1E293B
}
title Diagramme de cas d'utilisation — Sprint « Plans & activités »

left to right direction

actor "Utilisateur\nsite" as SU
actor "Utilisateur\ncorporate" as CU

rectangle "Plans & activités CSR" {
  usecase "Créer un plan\nannuel" as UC1
  usecase "Importer un plan\ndepuis Excel" as UC2
  usecase "Modifier le plan\n(brouillon)" as UC3
  usecase "Consulter l'historique\ndes modifications" as UC4
  usecase "Soumettre le plan\npour validation" as UC5
  usecase "Valider ou rejeter\nun plan" as UC6
  usecase "Consulter les plans\nvalidés (consolidé)" as UC7
  usecase "Gérer les activités\nplanifiées" as UC8
  usecase "Déclarer une activité\nhors plan" as UC9
}

SU --> UC1
SU --> UC2
SU --> UC3
SU --> UC4
SU --> UC5
SU --> UC8
SU --> UC9

CU --> UC6
CU --> UC7
CU --> UC4

UC5 ..> UC6 : <<include>>
UC2 ..> UC1 : <<extend>>
@enduml
