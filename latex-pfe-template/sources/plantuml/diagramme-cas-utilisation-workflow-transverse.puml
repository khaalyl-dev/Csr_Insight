@startuml
!theme plain
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam wrapWidth 220
title Diagramme de cas d'utilisation — Sprint 3 : Workflow transverse

left to right direction

actor "Utilisateur\nSite" as US
actor "Utilisateur\nCorporate" as UC

rectangle "Plateforme CSR — Sprint 3 (Workflow transverse)" {

  usecase "S'authentifier" as AUTH

  package "Soumission et validation des entités" {
    usecase "Soumettre une entité\n(plan ou activité)\npour validation" as SUBMIT
    usecase "Valider une entité\n(plan ou activité)" as VALID
    usecase "Rejeter une entité\n(plan ou activité)" as REJECT
  }

  package "Demandes de modification" {
    usecase "Soumettre une demande\nde modification\n(plan ou activité)" as CR_SUB
    usecase "Consulter les demandes\nde modification" as CR_LIST
    usecase "Approuver une demande\nde modification" as CR_APP
    usecase "Rejeter une demande\nde modification" as CR_REJ
  }

  package "Notifications et tâches" {
    usecase "Consulter les notifications" as NOTIF
    usecase "Marquer une notification\ncomme lue" as NOTIF_READ
    usecase "Consulter les tâches" as TASKS
  }

  package "Audit et traçabilité" {
    usecase "Consulter le journal d'audit" as AUDIT
    usecase "Filtrer l'historique d'audit" as AUDIT_FILT
  }

  note bottom of SUBMIT
    **Effets transverses (selon événements métier) :**
    création de notifications,
    génération ou mise à jour de tâches,
    enregistrement dans le journal d'audit.
  end note
}

' --- Site
US --> AUTH
US --> SUBMIT
US --> CR_SUB
US --> NOTIF
US --> NOTIF_READ
US --> TASKS

' --- Corporate
UC --> AUTH
UC --> VALID
UC --> REJECT
UC --> CR_LIST
UC --> CR_APP
UC --> CR_REJ
UC --> NOTIF
UC --> NOTIF_READ
UC --> TASKS
UC --> AUDIT
UC --> AUDIT_FILT

' --- Authentification requise
SUBMIT ..> AUTH : <<include>>
VALID ..> AUTH : <<include>>
REJECT ..> AUTH : <<include>>
CR_SUB ..> AUTH : <<include>>
CR_LIST ..> AUTH : <<include>>
CR_APP ..> AUTH : <<include>>
CR_REJ ..> AUTH : <<include>>
NOTIF ..> AUTH : <<include>>
NOTIF_READ ..> AUTH : <<include>>
TASKS ..> AUTH : <<include>>
AUDIT ..> AUTH : <<include>>
AUDIT_FILT ..> AUTH : <<include>>

' --- Filtrage dépend de la consultation du journal
AUDIT_FILT ..> AUDIT : <<include>>

@enduml
