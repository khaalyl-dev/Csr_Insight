# Copy to .env and adjust. load_dotenv runs when the backend starts (from backend/).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=csr_db
SECRET_KEY=change-me-in-production

# Optional: local Ollama for /api/chatbot/chat (must match `ollama serve` — default port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model name as shown by `ollama list` (e.g. phi3:mini, llama3.1:8b)
OLLAMA_MODEL=phi3:mini
# Cap new tokens (shorter answers; raise e.g. 512 for long explanations). Default 280.
OLLAMA_NUM_PREDICT=280
# Sampling 0–2; lower = steadier facts (phi3:mini / Apple Silicon). Default 0.2 in config if unset.
# OLLAMA_TEMPERATURE=0.2
# Optional: lower KV RAM vs Ollama default (e.g. 2048). Leave unset to use server default (often 4096 on GPU).
# OLLAMA_NUM_CTX=2048

# Local RAG (ChromaDB) — static docs + retrieval into the chatbot system prompt
RAG_ENABLED=true
RAG_TOP_K=4
# RAG_CHROMA_PATH=
# RAG_CORPUS_PATH=
# RAG_CHUNK_MAX_CHARS=600
